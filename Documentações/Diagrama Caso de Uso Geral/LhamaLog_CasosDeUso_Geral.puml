@startuml LhamaLog_CasosDeUso_Geral
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam actorStyle stickman
skinparam linetype ortho

skinparam usecase {
  BackgroundColor #EBF8FF
  BorderColor #005A9C
}

skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #999999
}

' ============================================================
' ATORES
' ============================================================

actor "Usuário do Sistema" as Usuario
actor Gestor
actor Sistema

actor "Sistema Terceiro de\nAssinatura/Pagamento" as SistemaPagamento

actor "Módulo de Controle de Lotes\n(Batch Controller)" as BatchController
actor "Módulo de Ingestão" as ModuloIngestao
actor "Módulo de Segurança" as ModuloSeguranca
actor "Módulo de Roteamento\n(Dispatcher)" as Dispatcher
actor "Módulo de Relatórios" as ModuloRelatorios
actor "Módulo Agendador\n(Scheduler)" as Scheduler

actor "Gateway de Pagamento" as Gateway
actor "Serviço de Autenticação" as ServicoAutenticacao


' ============================================================
' CASOS DE USO DO USUÁRIO
' ============================================================

package "Casos de Uso do Usuário (USID)" as PktUserStories {

  package "Ocorrência" as PktOcorrencia {
    usecase "Visualizar Ocorrências Processados" as USID_001
    usecase "Consultar Ocorrência" as USID_002
    usecase "Marcar Ocorrência" as USID_003
    usecase "Arquivar Ocorrência" as USID_004
    usecase "Filtrar Ocorrência" as USID_005
    usecase "Importar Arquivo" as USID_006
    usecase "Consultar Arquivos Processados" as USID_007
    usecase "Configurar Periodo de Retenção de Arquivos" as USID_008
  }

  package "Notificação" as PktNotificacao {
    usecase "Receber Notificação Email" as USID_009
    usecase "Receber Notificação Push" as USID_010
    usecase "Receber Notificação Web" as USID_011
    usecase "Configurar recepção de notificação" as USID_012
    usecase "Visualizar Notificação" as USID_013
    usecase "Visualizar Notificação (Mobile)" as USID_014
  }

  package "SDK e Executável" as PktSDK {
    usecase "Implementar SDK" as USID_015
    usecase "Gerenciar Tokens" as USID_016
    usecase "Baixar SDK" as USID_017
    usecase "Baixar Executável" as USID_018
    usecase "Configurar Executável" as USID_019
    usecase "Iniciar Execução" as USID_020
  }

  package "Empresa e Produto" as PktEmpresaProduto {
    usecase "Manter Informações Empresarial" as USID_021
    usecase "Manter Contexto de atuação empresarial" as USID_022
    usecase "Manter Contexto de Produto" as USID_023
    usecase "Implementar Produto" as USID_024
  }

  package "Varredura" as PktVarredura {
    usecase "Forçar execução de Varredura" as USID_025
    usecase "Configurar Agendamento de Varredura" as USID_026
    usecase "Habilitar Varredura Avançada" as USID_027
    usecase "Abrir o link do Agente LLM" as USID_028
  }

  package "Gestão de Acesso" as PktGestaoAcesso {
    usecase "Manter Gestor" as USID_029
    usecase "Controle de Acesso dos gestores aos Produtos" as USID_030
  }

  package "Dashboard e Relatório" as PktDashboard {
    usecase "Visualizar Dashboard" as USID_031
    usecase "Filtrar Dashboard" as USID_032
    usecase "Exportar Relatório" as USID_033
    usecase "Visualizar Dashboard Empresarial" as USID_034
    usecase "Exportar Relatório Empresarial" as USID_035
    usecase "Filtrar Dashboard Empresarial" as USID_036
    usecase "Filtrar Ocorrências Empresarial (Multi-Produto)" as USID_037
    usecase "Visualizar Dashboard (Mobile)" as USID_038
  }

  package "Assinatura" as PktAssinatura {
    usecase "Visualizar Assinatura" as USID_039
    usecase "Contratar Assinatura" as USID_040
    usecase "Alterar Assinatura" as USID_041
    usecase "Cancelar Assinatura" as USID_042
    usecase "Reembolsar Assinatura" as USID_043
  }

  package "Sugestão" as PktSugestao {
    usecase "Solicitar Sugestão" as USID_044
    usecase "Visualizar Sugestão" as USID_045
    usecase "Avaliar Sugestão" as USID_046
    usecase "Fechar Sugestão" as USID_047
  }

  package "Autenticação" as PktAutenticacao {
    usecase "Manter Usuário" as USID_048
    usecase "Logar na Web" as USID_049
    usecase "Logar Mobile" as USID_050
    usecase "Manter 2FA" as USID_051
  }
