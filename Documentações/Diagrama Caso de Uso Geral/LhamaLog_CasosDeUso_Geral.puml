' ============================================================
' INTEGRAÇÕES DO SISTEMA
' ============================================================

package "Integrações do Sistema (SSID)" as PktIntegracoes {

  package "Integração - Coletor" as PktColetor {
    usecase "Conectar o Utilitário" as SSID_001
    usecase "Manter Logs" as SSID_002
    usecase "Enfileirar Logs" as SSID_003
    usecase "Executar Varredura (Forçar Varredura)" as SSID_005
    usecase "Executar Varredura Agendada" as SSID_006
    usecase "Criar Agendamento de Varredura" as SSID_012
    usecase "Enviar Arquivo (Importado) para Varredura" as SSID_013
    usecase "Manter Tokens de Conexão" as SSID_014
  }

  package "Integração - Finder" as PktFinder {
    usecase "Marcar como Analisado" as SSID_004
    usecase "Identificar Ocorrência" as SSID_007
    usecase "Executar Varredura Avançada" as SSID_008
    usecase "Enviar Ocorrências" as SSID_009
    usecase "Registrar Ocorrência" as SSID_010
    usecase "Usar Contexto" as SSID_015
  }

  package "Integração - Gateway de Pagamento" as PktGateway {
    usecase "Manter Assinatura" as SSID_016
    usecase "Integração de Pagamento" as SSID_018
  }

  package "Integração - Serviços Externos" as PktServExt {
    usecase "Integração de Autenticação" as SSID_017
    usecase "Integração de Notificação" as SSID_019
    usecase "Integração de LLM" as SSID_020
  }

  package "Integração - Relatórios" as PktSsidUsuario {
    usecase "Gerar Relatórios" as SSID_011
  }
}


' ============================================================
' RELACIONAMENTOS DOS ATORES
' ============================================================

' ------------------------------------------------------------
' USUÁRIO
' Possui relacionamento com TODOS os UCs destes pacotes.
' Portanto, usamos uma única seta para cada pacote.
' ------------------------------------------------------------

Usuario --> PktOcorrencia
Usuario --> PktNotificacao
Usuario --> PktSDK
Usuario --> PktEmpresaProduto
Usuario --> PktVarredura
Usuario --> PktGestaoAcesso
Usuario --> PktDashboard
Usuario --> PktAssinatura
Usuario --> PktSugestao
Usuario --> PktAutenticacao


' Usuário em integrações específicas
Usuario --> SSID_002
Usuario --> SSID_005


' ------------------------------------------------------------
' GESTOR
' Relaciona-se somente com USID_002 até USID_007 e USID_008.
' Como não cobre todos os UCs do pacote Ocorrência,
' as associações são individuais.
' ------------------------------------------------------------

Gestor --> USID_002
Gestor --> USID_003
Gestor --> USID_004
Gestor --> USID_005
Gestor --> USID_006
Gestor --> USID_007
Gestor --> USID_008


' ------------------------------------------------------------
' SISTEMA
' Relacionamentos individuais, pois não cobre todos os UCs
' de nenhum dos pacotes.
' ------------------------------------------------------------

Sistema --> SSID_001
Sistema --> SSID_002
Sistema --> SSID_003
Sistema --> SSID_005
Sistema --> SSID_006
Sistema --> SSID_013
Sistema --> SSID_014
Sistema --> SSID_015
Sistema --> SSID_019
Sistema --> SSID_020


' ------------------------------------------------------------
' SISTEMA TERCEIRO DE ASSINATURA/PAGAMENTO
' Atua somente nos quatro casos de assinatura abaixo.
' ------------------------------------------------------------

SistemaPagamento --> USID_040
SistemaPagamento --> USID_041
SistemaPagamento --> USID_042
SistemaPagamento --> USID_043


' ------------------------------------------------------------
' GATEWAY DE PAGAMENTO
' Atua em TODOS os UCs do pacote "Integração - Gateway
' de Pagamento", portanto uma única seta para o pacote.
' ------------------------------------------------------------

Gateway --> PktGateway


' ------------------------------------------------------------
' MÓDULOS INTERNOS
' Cada um possui relacionamento com apenas um UC.
' ------------------------------------------------------------

BatchController --> SSID_004

ModuloIngestao --> SSID_007
ModuloIngestao --> SSID_010

ModuloSeguranca --> SSID_008

Dispatcher --> SSID_009

ModuloRelatorios --> SSID_011

Scheduler --> SSID_012

ServicoAutenticacao --> SSID_017


